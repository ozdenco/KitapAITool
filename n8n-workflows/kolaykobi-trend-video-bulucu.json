        "operation": "sendAndWait",
        "email": "={{ $json.email }}",
        "subject": "={{ $json.biz }} — Günün Trend Video Fikirleri",
        "html": "=<!DOCTYPE html><html lang='tr'><head><meta charset='UTF-8'></head><body style='font-family:system-ui,sans-serif;background:#F7F6F2;padding:2rem'><div style='max-width:680px;margin:0 auto;background:#fff;border-radius:16px;padding:2rem;border:0.5px solid #E2E0D8'>\n<div style='color:#1D9E75;font-size:13px;font-weight:500;letter-spacing:.04em;margin-bottom:1.5rem'>KOLAY KOBİ</div>\n<h1 style='font-size:22px;color:#1C1B19;margin-bottom:.4rem'>📈 Günün Trend Video Fikirleri</h1>\n<p style='font-size:14px;color:#6B6963;margin-bottom:2rem'>{{ $json.biz }} — {{ $json.sector === 'ALL' ? 'Tüm Sektörler' : $json.sector }}<br/>Ton: {{ ($json.tones || []).join(' + ') }}<br/>Tarih: {{ new Date().toLocaleDateString('tr-TR') }}</p>\n<div style='background:#F7F6F2;padding:1rem;border-radius:8px;font-size:13px;color:#1C1B19;white-space:pre-wrap;line-height:1.6'>{{ $json.emailContent }}</div>\n<div style='background:#F0FAF6;border-radius:8px;padding:1rem;margin-top:1.5rem;text-align:center'>\n<p style='font-size:13px;color:#0F6E56;margin:0'>Bu raporu her gün almak için Kolay KOBİ Trend Video Bulucu'yu kullanın.</p>\n<a href='https://kolaykobi.com' style='display:inline-block;background:#1D9E75;color:#fff;padding:10px 24px;border-radius:8px;text-decoration:none;font-size:14px;margin-top:.75rem'>Kolay KOBİ'yi Aç</a>\n</div></div></body></html>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "send-email-once",
