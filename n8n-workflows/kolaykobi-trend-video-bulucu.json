    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.schedules) staticData.schedules = {};\nconst id = 'sch_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);\nstaticData.schedules[id] = {\n  id,\n  biz: data.biz,\n  sector: data.sector,\n  email: data.email,\n  tones: data.tones,\n  audience: data.audience || '',\n  note: data.note || '',\n  prompt: data.prompt,\n  hour: data.hour,\n  days: data.days,\n  createdAt: new Date().toISOString(),\n  active: true,\n};\nreturn [{ json: { ...data, scheduleId: id, scheduleSaved: true } }];"
      },
