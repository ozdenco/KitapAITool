      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "kolay-kobi-universal"
    },
    {
      "parameters": {
        "jsCode": "// ── Rate Limiting (IP bazlı, günlük 5 istek) ──────────────────────────\nconst ip = $input.first().json.headers?.['x-forwarded-for']?.split(',')[0]?.trim()\n          || $input.first().json.headers?.['x-real-ip']\n          || 'unknown';\n\nconst today = new Date().toISOString().slice(0, 10);\nconst key   = `rl_${ip}_${today}`;\n\nconst staticData = $getWorkflowStaticData('global');\n\nif (!staticData.rateLimits) staticData.rateLimits = {};\n\n// Eski tarihleri temizle (bellek yönetimi)\nconst yesterday = new Date();\nyesterday.setDate(yesterday.getDate() - 1);\nconst cutoff = yesterday.toISOString().slice(0, 10);\nfor (const k of Object.keys(staticData.rateLimits)) {\n  if (k.includes(cutoff) || k < `rl_${ip}_${cutoff}`) {\n    delete staticData.rateLimits[k];\n  }\n}\n\nconst current = staticData.rateLimits[key] || 0;\nconst LIMIT = 5;\n\nif (current >= LIMIT) {\n  return [{ json: { rateLimitExceeded: true, ip, current } }];\n}\n\nstaticData.rateLimits[key] = current + 1;\n\nconst body = $input.first().json.body;\nreturn [{ json: { rateLimitExceeded: false, prompt: body.prompt, ip } }];"
      },
      "id": "rate-limit-node",
      "name": "Rate Limit Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-rate-limit",
              "leftValue": "={{ $json.rateLimitExceeded }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-rate-limited",
      "name": "Rate Limited?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"rate_limit\", \"message\": \"Günlük kullanım limitine ulaştınız. Yarın tekrar deneyin.\" }",
        "options": {
