{
  "name": "Kolay KOBİ — 30 Günlük İçerik Takvimi (Asenkron)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kolay-kobi-takvim",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-start-node",
      "name": "Webhook Start",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        280
      ],
      "webhookId": "kolay-kobi-takvim"
    },
    {
      "parameters": {
        "jsCode": "const ip = $input.first().json.headers?.['x-forwarded-for']?.split(',')[0]?.trim() || $input.first().json.headers?.['x-real-ip'] || 'unknown';\nconst today = new Date().toISOString().slice(0, 10);\nconst key = 'rl_takvim_' + ip + '_' + today;\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.rateLimits) staticData.rateLimits = {};\nconst current = staticData.rateLimits[key] || 0;\nif (current >= 50) {\n  return [{ json: { rateLimitExceeded: true } }];\n}\nstaticData.rateLimits[key] = current + 1;\nconst body = $input.first().json.body || $input.first().json;\nreturn [{ json: { rateLimitExceeded: false, prompt: body.prompt } }];"
      },
      "id": "rate-limit-node",
      "name": "Rate Limit Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.rateLimitExceeded }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-rate-limited",
      "name": "Rate Limited?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        280
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"error\":\"rate_limit\"}",
        "options": {
          "responseCode": 429
        }
      },
      "id": "respond-rate-limit",
      "name": "429 Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        900,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// job_id üretir ve staticData'da 'pending' durumuyla kaydeder — bu kayıt,\n// aşağıdaki Webhook Status ucundan polling ile sorgulanacak. staticData\n// workflow'a bağlı, tüm execution'lar arasında paylaşılır (rate-limit'te\n// zaten aynı mekanizma kullanılıyor).\nconst jobId = [...Array(24)].map(() => Math.floor(Math.random()*36).toString(36)).join('');\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.jobs) staticData.jobs = {};\n// Eski job kayıtlarını temizle (24 saatten eski) — staticData sınırsız\n// büyümesin diye.\nconst cutoff = Date.now() - 24*60*60*1000;\nObject.keys(staticData.jobs).forEach(id => { if ((staticData.jobs[id].createdAt||0) < cutoff) delete staticData.jobs[id]; });\nstaticData.jobs[jobId] = { status: 'pending', createdAt: Date.now() };\nconst data = $input.first().json;\nreturn [{ json: { ...data, jobId } }];"
      },
      "id": "generate-job-node",
      "name": "Generate Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ job_id: $json.jobId, status: 'pending' }) }}",
        "options": {
          "responseCode": 202,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "respond-job-id",
      "name": "Respond With Job ID",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1120,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst apiBody = {\n  model: 'MiniMax-M3',\n  max_completion_tokens: 24000,\n  messages: [{ role: 'user', content: data.prompt || '' }]\n};\nreturn [{ json: { ...data, apiBody } }];"
      },
      "id": "build-body-node",
      "name": "Build Request Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.minimax.io/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_MINIMAX_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept-Charset",
              "value": "utf-8"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "options": {
          "timeout": 300000
        },
        "jsonBody": "={{ $json.apiBody }}"
      },
      "id": "minimax-api-node",
      "name": "MiniMax API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueErrorOutput",
      "position": [
        1560,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nlet text = data.choices?.[0]?.message?.content || '';\nconst jsonStart = text.indexOf('{');\nconst jsonEnd = text.lastIndexOf('}');\nif (jsonStart !== -1 && jsonEnd !== -1) text = text.slice(jsonStart, jsonEnd + 1);\nreturn [{ json: { content: [{ type: 'text', text }], jobId: data.jobId } }];"
      },
      "id": "response-transform",
      "name": "Response Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// Başarılı sonucu job kaydına yazar — polling ucunda bu okunacak.\nconst data = $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.jobs) staticData.jobs = {};\nstaticData.jobs[data.jobId] = { status: 'completed', result: { content: data.content }, completedAt: Date.now() };\nreturn [{ json: { ok: true } }];"
      },
      "id": "save-job-result",
      "name": "Save Job Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// MiniMax API hata verirse (timeout, 5xx vb.) job kaydını 'error' olarak\n// işaretler. NOT: n8n'in continueErrorOutput hata çıktısı, orijinal girdi\n// alanlarını (jobId dahil) her zaman garanti etmeyebilir — canlıda ilk\n// hatalı çalıştırmadan sonra $json.jobId boş geliyorsa, MiniMax API\n// düğümünün \"Always Output Data\" seçeneğini açıp burada $json içeriğini\n// (n8n execution log'undan) kontrol edip gerekirse eşlemeyi güncelleyin.\nconst data = $input.first().json;\nconst jobId = data.jobId || data.json?.jobId;\nif (jobId) {\n  const staticData = $getWorkflowStaticData('global');\n  if (!staticData.jobs) staticData.jobs = {};\n  staticData.jobs[jobId] = { status: 'error', error: data.error?.message || data.message || 'AI isteği başarısız', completedAt: Date.now() };\n}\nreturn [{ json: { ok: false, jobId } }];"
      },
      "id": "save-job-error",
      "name": "Save Job Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        420
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "kolay-kobi-takvim-status",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-status-node",
      "name": "Webhook Status",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        560
      ],
      "webhookId": "kolay-kobi-takvim-status"
    },
    {
      "parameters": {
        "jsCode": "const jobId = $input.first().json.query?.jobId || '';\nconst staticData = $getWorkflowStaticData('global');\nconst job = (staticData.jobs || {})[jobId];\nif (!job) return [{ json: { status: 'not_found' } }];\nreturn [{ json: job }];"
      },
      "id": "get-job-status",
      "name": "Get Job Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        560
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "respond-status",
      "name": "Respond Status",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        680,
        560
      ]
    }
  ],
