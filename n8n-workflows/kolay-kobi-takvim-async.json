{
  "name": "Kolay KOBİ — 30 Günlük İçerik Takvimi (Job Başlat)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kolay-kobi-takvim",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-start-node",
      "name": "Webhook Start",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "kolay-kobi-takvim"
    },
    {
      "parameters": {
        "jsCode": "const ip = $input.first().json.headers?.['x-forwarded-for']?.split(',')[0]?.trim() || $input.first().json.headers?.['x-real-ip'] || 'unknown';\nconst today = new Date().toISOString().slice(0, 10);\nconst key = 'rl_takvim_' + ip + '_' + today;\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.rateLimits) staticData.rateLimits = {};\nconst current = staticData.rateLimits[key] || 0;\nif (current >= 50) {\n  return [{ json: { rateLimitExceeded: true } }];\n}\nstaticData.rateLimits[key] = current + 1;\nconst body = $input.first().json.body || $input.first().json;\nreturn [{ json: { rateLimitExceeded: false, prompt: body.prompt, dayCount: body.dayCount } }];"
      },
      "id": "rate-limit-node",
      "name": "Rate Limit Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.rateLimitExceeded }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-rate-limited",
      "name": "Rate Limited?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"error\":\"rate_limit\"}",
        "options": {
          "responseCode": 429
        }
      },
      "id": "respond-rate-limit",
      "name": "429 Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        900,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "// job_id üretir. NOT: Bu workflow'un staticData'sı Worker workflow'unun\n// staticData'sından AYRI (n8n'de her workflow'un kendi static data'sı var)\n// — bu yüzden burada job kaydı YAZMIYORUZ, sadece kimliği üretip Worker'a\n// iletiyoruz. İlk 'pending' kaydını Worker, kendi ilk adımında yazacak.\nconst jobId = [...Array(24)].map(() => Math.floor(Math.random()*36).toString(36)).join('');\nconst data = $input.first().json;\nreturn [{ json: { ...data, jobId } }];"
      },
      "id": "generate-job-node",
      "name": "Generate Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://n8n.srv1492396.hstgr.cloud/webhook/kolay-kobi-takvim-worker",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { jobId: $json.jobId, prompt: $json.prompt, dayCount: $json.dayCount } }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "trigger-worker-node",
      "name": "Trigger Worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [
        1120,
        320
      ],
      "notesInFlow": true,
      "notes": "Fire-and-forget: Worker'ın webhook'unu tetikler, kısa timeout (5sn) ile. n8n isteği ALDIĞI an execution'ı başlatır — bu node'un kendi yanıtını bekleyip beklememesi Worker'ın çalışmaya devam etmesini etkilemez. onError=continueRegularOutput: bu çağrı zaman aşımına uğrasa/hata verse bile Job Başlat akışı BAŞARISIZ olmaz, kullanıcıya yine de job_id döneriz."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ job_id: $('Generate Job').item.json.jobId, status: 'pending' }) }}",
        "options": {
          "responseCode": 202,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "respond-job-id",
      "name": "Respond With Job ID",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1340,
        320
      ]
    }
  ],
  "connections": {
    "Webhook Start": {
      "main": [
        [
          {
            "node": "Rate Limit Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rate Limit Check": {
      "main": [
        [
          {
            "node": "Rate Limited?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rate Limited?": {
      "main": [
        [
          {
            "node": "429 Response",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Generate Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Job": {
      "main": [
        [
          {
            "node": "Trigger Worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Worker": {
      "main": [
        [
          {
            "node": "Respond With Job ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    "kolay-kobi",
    "minimax",
    "async"
  ]
}
